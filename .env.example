# Anthropic API Key (스크립트 생성 - Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (DALL-E 3 이미지 생성)
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (스크립트 생성 - 기존)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Key (음성 합성)
# https://elevenlabs.io/app/settings/api-keys 에서 발급
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Voice ID (원장님 목소리 ID)
# Voice Library에서 클론한 목소리 ID 또는 기본 Voice ID 입력
# 기본값: pFZP5JQG7iQjIQuC4Bku (Lily - 다국어 여성)
ELEVENLABS_VOICE_ID=your_voice_id_here

# Pexels API Key (B-roll 이미지, 선택사항)
PEXELS_API_KEY=your_pexels_api_key_here
