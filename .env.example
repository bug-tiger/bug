# Anthropic API Key (스크립트 생성 - Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Leonardo AI API Key (이미지 생성)
# https://app.leonardo.ai/api-access 에서 발급
LEONARDO_API_KEY=your_leonardo_api_key_here

# Leonardo AI Model ID (선택사항)
# 추천 모델:
# - 6bef9f1b-29cb-40c7-b9df-32b51c1f67d3 (Leonardo Creative)
# - e316348f-7773-490e-adcd-46757c738eb7 (Leonardo Diffusion XL)
# - 1e60896f-3c26-4296-8ecc-53e2afecc132 (Leonardo Lightning XL - 빠른 생성, 기본값)
LEONARDO_MODEL_ID=1e60896f-3c26-4296-8ecc-53e2afecc132

# Google Gemini API Key (스크립트 생성 - 기존)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Key (음성 합성)
# https://elevenlabs.io/app/settings/api-keys 에서 발급
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Voice ID (원장님 목소리 ID)
# Voice Library에서 클론한 목소리 ID 또는 기본 Voice ID 입력
# 기본값: pFZP5JQG7iQjIQuC4Bku (Lily - 다국어 여성)
ELEVENLABS_VOICE_ID=your_voice_id_here

# Pexels API Key (B-roll 이미지, 선택사항)
PEXELS_API_KEY=your_pexels_api_key_here
